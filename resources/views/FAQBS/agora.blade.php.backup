    <!-- Regroupement PHP des discussions -->
    @php
        $groupIcons = [
            'Président' => 'bi-person-circle',
            'Secrétariat' => 'bi-file-text',
            'Trésorerie' => 'bi-cash-coin',
            'Donneurs de Voix' => 'bi-mic',
            'Donneurs de Temps' => 'bi-clock',
        ];
        
        $desiredOrder = ['Président', 'Secrétariat', 'Trésorerie', 'Donneurs de Voix', 'Donneurs de Temps'];
        
        $allGroups = [];
        $discussionsArray = [];
        
        if (isset($discussions) && ($discussions instanceof \Illuminate\Support\Collection || is_array($discussions))) {
            $discussionsArray = ($discussions instanceof \Illuminate\Support\Collection) ? $discussions->all() : $discussions;
        }
        
        $groupMapping = [
            'donneurs de voix' => 'Donneurs de Voix', 'donneur de voix' => 'Donneurs de Voix',
            'donneurs voix' => 'Donneurs de Voix', 'voix' => 'Donneurs de Voix',
            'donneurs de temps' => 'Donneurs de Temps', 'donneur de temps' => 'Donneurs de Temps',
            'donneurs temps' => 'Donneurs de Temps', 'temps' => 'Donneurs de Temps',
            'trésorerie' => 'Trésorerie', 'trésoreri' => 'Trésorerie', 'tresorerie' => 'Trésorerie',
            'sécrétariat' => 'Secrétariat', 'secrétariat' => 'Secrétariat', 'secretariat' => 'Secrétariat',
            'président' => 'Président', 'president' => 'Président',
        ];
        
        foreach ($discussionsArray as $discussion) {
            $groupName = $discussion->group ?? '';
            $normalizedName = trim($groupName);
            $lowerName = strtolower($normalizedName);
            
            $found = false;
            foreach ($groupMapping as $key => $standardName) {
                if (str_contains($lowerName, $key)) {
                    $normalizedName = $standardName;
                    $found = true;
                    break;
                }
            }
            
            if (!$found) {
                $normalizedName = $normalizedName ?: 'Président';
            }
            
            if (!isset($allGroups[$normalizedName])) {
                $allGroups[$normalizedName] = [];
            }
            $allGroups[$normalizedName][] = $discussion;
        }
        
        $filteredGroups = [];
        foreach ($desiredOrder as $group) {
            $filteredGroups[$group] = $allGroups[$group] ?? [];
        }
        $allGroups = $filteredGroups;
    @endphp

